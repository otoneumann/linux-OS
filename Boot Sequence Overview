## 10. Quick Command Reference

### GRUB
sudo nano /etc/default/grub       # Edit GRUB config
sudo update-grub                  # Regenerate /boot/grub/grub.cfg

### Kernel
uname -r                          # Show running kernel version
lsmod                             # List loaded kernel modules
modprobe <module_name>            # Load a kernel module
rmmod <module_name>               # Unload a kernel module
dmesg | tail -20                  # Last 20 kernel messages
journalctl -k                     # Kernel messages via journald
sudo apt install linux-image-*    # Install new kernel
sudo apt autoremove               # Remove old kernels

### Initramfs
sudo update-initramfs -u          # Regenerate initrd for current kernel
lsinitramfs /boot/initrd.img-*    # List initrd contents
cat /etc/initramfs-tools/modules  # View forced modules

### Systemd Targets
systemctl get-default                     # Show default boot target
systemctl set-default multi-user.target   # Set CLI as default
systemctl set-default graphical.target    # Set GUI as default
systemctl isolate rescue.target           # Switch to rescue now
systemctl isolate multi-user.target       # Switch to CLI now
systemctl isolate graphical.target        # Switch to GUI now

### Boot Inspection
findmnt /                         # Show root mount info
df -h /                           # Root filesystem usage
ls -la /boot/                     # List boot files
file /boot/vmlinuz-*              # Identify kernel file type
readlink /boot/vmlinuz            # Resolve kernel symlink
cat /proc/cmdline                 # Show active kernel boot params